# Copia a .env para desarrollo local. En Cloud Run los secretos vienen de Secret Manager.

# --- Núcleo (mcp_core) ---
MCP_ENVIRONMENT=local
MCP_SERVER_NAME=boostr-kyc
MCP_BASE_URL=http://localhost:8000
MCP_PORT=8000
# none | azure | google  ("none" solo funciona con MCP_ENVIRONMENT=local)
MCP_AUTH_PROVIDER=none
# Roles manuales (JSON). En local, "local-dev" es el usuario sin autenticación.
MCP_ROLE_ASSIGNMENTS={"local-dev": ["kyc.judicial"]}

# Entra ID (Azure AD) del cliente
# MCP_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# MCP_AZURE_CLIENT_ID=
# MCP_AZURE_CLIENT_SECRET=
# MCP_AZURE_SCOPE=mcp.access

# Google Workspace del cliente
# MCP_GOOGLE_CLIENT_ID=
# MCP_GOOGLE_CLIENT_SECRET=
# MCP_GOOGLE_ALLOWED_DOMAINS=["cliente.cl"]

# Obligatorios fuera de local
# MCP_JWT_SIGNING_KEY=           # openssl rand -base64 48
# MCP_STORAGE_ENCRYPTION_KEY=    # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# MCP_STORAGE_BACKEND=firestore
# MCP_AUDIT_HASH_SALT=           # openssl rand -hex 32

# --- Boostr ---
BOOSTR_API_KEY=
# BOOSTR_WEBHOOK_SECRET=         # openssl rand -hex 24
